import sys
from collections import deque

input = sys.stdin.readline

N, M = map(int, input().split())

g = [[] for _ in range(N + 1)]

for _ in range(M):
    A, B = map(int, input().split())
    g[B].append(A)
    
visited = [0] * (N + 1)
stamp = 0

max_cnt = 0
answer = []
for start in range(1, N + 1):
    stamp += 1
    q = deque([start])
    visited[start] = stamp
    cnt = 1
    
    while q:
        x = q.popleft()
        for nx in g[x]:
            if visited[nx] != stamp:
                visited[nx] = stamp
                cnt += 1
                q.append(nx)
    if cnt > max_cnt:
        max_cnt = cnt
        answer = [start]
    elif cnt == max_cnt:
        answer.append(start)
        
print(*answer)